# فقط وقتی گواهی موجود شود فعال واقعی است — الان ssl روی فایل‌های ocserv
server {
    listen 8448 ssl;
    listen [::]:8448 ssl;
    server_name _;

    ssl_certificate /etc/ocserv/certs/server-cert.pem;
    ssl_certificate_key /etc/ocserv/certs/server-key.pem;

    location /u/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
